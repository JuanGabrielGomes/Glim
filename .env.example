# URL do checkout externo na Kiwify (destino de todos os botões de compra).
NEXT_PUBLIC_CHECKOUT_URL=

# URL de agendamento da Reunião 1 no Google Agenda (usada na página /obrigado).
NEXT_PUBLIC_BOOKING_URL=

# URL ou ID do vídeo da VSL no provedor escolhido.
NEXT_PUBLIC_VSL_URL=

# Provedor de hospedagem da VSL: youtube, vimeo, panda ou mp4.
NEXT_PUBLIC_VSL_PROVIDER=

# ID do Pixel da Meta (Facebook) para medir PageView e cliques no checkout.
NEXT_PUBLIC_META_PIXEL_ID=

# Link do WhatsApp da glim. para dúvidas (formato https://wa.me/55DDDNUMERO).
NEXT_PUBLIC_WHATSAPP_URL=

# URL pública do site, sem barra no fim (Open Graph, robots.txt e sitemap). Ex.: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=
